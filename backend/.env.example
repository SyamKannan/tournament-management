APP_NAME="Antigravity Sports SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite by default so a fresh clone runs with no database server.
# For MySQL/MariaDB or Postgres, set DB_CONNECTION and uncomment the rest.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sports_saas
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sports SaaS -------------------------------------------------------------

# Signing key for the SPA's bearer tokens. Generate a long random value per
# environment: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=antigravity_sports_saas_super_secret_jwt_key_2026
JWT_TTL_SECONDS=604800

# Real-time gateway (php artisan websocket:serve). Browsers connect to
# WEBSOCKET_PORT; the API pushes events over the loopback bridge.
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=4000
WEBSOCKET_PATH=/ws
WEBSOCKET_BRIDGE_HOST=127.0.0.1
WEBSOCKET_BRIDGE_PORT=4100
WEBSOCKET_BRIDGE_URL=http://127.0.0.1:4100

# Comma-separated front-end origins. Narrow this before deploying.
CORS_ALLOWED_ORIGINS=*

# Optional: AI-generated poster background art (platform.openai.com API key
# with image-generation access). Leave blank to keep poster generation on
# the plain template only — it never fails just because this is unset.
OPENAI_API_KEY=

# Optional fallback Razorpay keys. Gateways are normally chosen per payment
# flow in Admin > Platform Settings > Payments (Demo checkout or Razorpay with
# keys saved there); these are used when Razorpay is picked but no keys are saved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: match/tournament poster "art director" copy (console.anthropic.com
# API key). Leave blank to skip straight to the hardcoded poster copy —
# rendering still works, it just won't be match-aware. See the poster README
# section — this is independent of POSTER_CHROME_PATH below, which is
# required infrastructure, not an optional key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# REQUIRED for poster rendering regardless of any API key above: a real
# Chrome/Chromium binary Browsershot can drive (`npm install` in backend/
# only installs puppeteer-core, no bundled browser). Leave blank to
# auto-detect a local Chrome/Edge install (see PosterRenderer); production
# must set this explicitly, e.g. /usr/bin/chromium in the Docker image.
POSTER_CHROME_PATH=
