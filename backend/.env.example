APP_NAME="KickWick"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# x-demo-role header login (no password). Defaults to on only for APP_ENV=local/testing.
# DEMO_ROLE_SWITCHER=false

# The one account `db:seed` creates. Leave the password unset to have the seed
# generate one, print it once, and force a change at first sign-in.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME="Platform Admin"
# SUPER_ADMIN_PHONE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite by default so a fresh clone runs with no database server.
# For MySQL/MariaDB or Postgres, set DB_CONNECTION and uncomment the rest.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kickwick
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Set to `redis` to cache the public hub, fixtures, brackets and player stats
# (App\Support\Cached). On any other store that cache stays off unless
# RESPONSE_CACHE_ENABLED=true. TTLs: CACHE_TTL_HUB / _STATS / _PLATFORM.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis is pure PHP (composer); phpredis needs the PHP extension.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- KickWick ----------------------------------------------------------------

# Signing key for the SPA's bearer tokens. Generate a long random value per
# environment: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_TTL_SECONDS=604800

# Real-time gateway (php artisan websocket:serve). Browsers connect to
# WEBSOCKET_PORT; the API pushes events over the loopback bridge.
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=4000
WEBSOCKET_PATH=/ws
WEBSOCKET_BRIDGE_HOST=127.0.0.1
WEBSOCKET_BRIDGE_PORT=4100
WEBSOCKET_BRIDGE_URL=http://127.0.0.1:4100

# Comma-separated front-end origins. Narrow this before deploying.
CORS_ALLOWED_ORIGINS=*

# Optional: AI key art behind tournament posters. OpenAI's image model (high
# quality) is used when set, else Gemini's image model via GEMINI_API_KEY below.
# With neither, posters use the designed templates' own artwork — never a failure.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional fallback Razorpay keys. Gateways are normally chosen per payment
# flow in Admin > Platform Settings > Payments (Demo checkout or Razorpay with
# keys saved there); these are used when Razorpay is picked but no keys are saved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: match/tournament poster "art director" copy (console.anthropic.com
# API key). Leave blank to skip straight to the hardcoded poster copy —
# rendering still works, it just won't be match-aware. See the poster README
# section — this is independent of POSTER_CHROME_PATH below, which is
# required infrastructure, not an optional key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# With no GEMINI_API_KEY below, this key also powers the Scorey chat assistant.
ASSISTANT_MODEL=claude-opus-5

# Scorey, the public chat assistant (POST /api/assistant/chat). A free key from
# https://aistudio.google.com/apikey works (free tier: rate limited, and Google may
# use prompts to improve its products). Takes priority over ANTHROPIC_API_KEY.
# Leave both blank and the chat answers "not available".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# REQUIRED for poster rendering regardless of any API key above: a real
# Chrome/Chromium binary Browsershot can drive (`npm install` in backend/
# only installs puppeteer-core, no bundled browser). Leave blank to
# auto-detect a local Chrome/Edge install (see PosterRenderer); production
# must set this explicitly, e.g. /usr/bin/chromium in the Docker image.
POSTER_CHROME_PATH=

# --- WhatsApp / SMS delivery ------------------------------------------------
# `log` records messages instead of sending them. Fine locally; in production
# it means password reset codes never reach anyone (the super admin dashboard
# flags this). Drivers: log | twilio | meta_whatsapp
NOTIFICATIONS_ENABLED=true
# Whether the product offers messaging at all. Unset answers itself: the
# WhatsApp/SMS pages and the SMS password-reset route appear once a channel
# below names a real driver. true/false overrides that.
MESSAGING_ENABLED=
SMS_DRIVER=log
WHATSAPP_DRIVER=log

# Twilio — one account covers SMS and WhatsApp.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SMS_FROM=                 # a Twilio number, or your DLT sender ID (e.g. KCKWCK)
TWILIO_WHATSAPP_FROM=            # e.g. +14155238886 (sandbox) or your WhatsApp sender
TWILIO_MESSAGING_SERVICE_SID=    # MG… — used instead of the two FROMs when set
# Approved WhatsApp Content templates (HX…), one per event. Each template's
# body is a single variable {{1}}; unmapped events go as free text, which
# WhatsApp only delivers within 24h of the person messaging you.
TWILIO_WA_PASSWORD_RESET=
TWILIO_WA_MATCH_REMINDER=
TWILIO_WA_FEE_DUE=
# Check with: php artisan notifications:test <phone> [--channel=whatsapp]

# WhatsApp Cloud API (Meta). Map events to approved templates in
# config/notifications.php `whatsapp_templates`.
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
